# Copy to `.dev.vars` for local `wrangler pages dev`. In production these are set
# as Pages environment variables / secrets in the Cloudflare dashboard instead.
# NEVER commit real values — .dev.vars is gitignored.

# Discord application (Developer Portal → your app → OAuth2)
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# Random long string for signing session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change_me_to_a_long_random_string

# The bot's in-process API, reached through the Cloudflare Tunnel.
# e.g. https://bot.yourdomain.com   (no trailing /api)
BOT_API_URL=https://your-bot-tunnel-hostname

# Must match DASHBOARD_API_SECRET in the bot's own .env
DASHBOARD_API_SECRET=must_match_the_bot

# Public base URL of the R2 bucket that stores uploaded images.
# e.g. https://media.yourdomain.com  or the bucket's r2.dev URL.
# The MEDIA binding (in wrangler.toml) is what actually stores objects; this is
# how they're served back. For local dev, wrangler provides a local R2.
R2_PUBLIC_URL=https://your-r2-public-base
